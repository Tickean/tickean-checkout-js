{
  "name": "tickean-checkout-js",
  "private": true,
  "version": "0.1.0",
  "description": "Tickean Headless Checkout SDK monorepo",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @tickean/checkout-js && npm run build -w @tickean/react-checkout",
    "test": "npm run build -w @tickean/checkout-js && npm run test -w @tickean/checkout-js && npm run test -w @tickean/react-checkout",
    "test:e2e": "npm run test:e2e -w nextjs-custom-checkout",
    "lint": "echo \"lint placeholder\"",
    "example:dev": "npm run dev -w nextjs-custom-checkout",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1"
  },
  "engines": {
    "node": ">=18"
  }
}
